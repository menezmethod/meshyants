{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshyants.dev/experiments/schema/run-result.schema.json",
  "title": "MeshyAnts single arm-repeat result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "system",
    "seed",
    "git_sha",
    "budget_used",
    "budget_exceeded",
    "protocol_violation",
    "metrics",
    "per_task"
  ],
  "properties": {
    "contract_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "system": {
      "enum": [
        "single_agent",
        "manager_worker",
        "central_router",
        "meshyants",
        "flat_blackboard"
      ]
    },
    "seed": { "type": "integer" },
    "git_sha": { "type": "string", "minLength": 1 },
    "budget_used": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_ms",
        "model_calls",
        "input_tokens",
        "output_tokens",
        "cost_micros",
        "worker_wakeups",
        "exclusive_lease_attempts"
      ],
      "properties": {
        "wall_ms": { "type": "integer", "minimum": 0 },
        "model_calls": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cost_micros": { "type": "integer", "minimum": 0 },
        "worker_wakeups": { "type": "integer", "minimum": 0 },
        "exclusive_lease_attempts": { "type": "integer", "minimum": 0 }
      }
    },
    "budget_exceeded": { "type": "boolean" },
    "protocol_violation": { "type": ["string", "null"] },
    "metrics": { "type": "object", "additionalProperties": { "type": ["number", "null"] } },
    "per_task": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "triggered", "passed", "quality", "attempts", "duplicate_executions"],
        "properties": {
          "task_id": { "type": "string" },
          "triggered": { "type": "boolean" },
          "passed": { "type": "boolean" },
          "quality": { "type": ["number", "null"] },
          "attempts": { "type": "integer", "minimum": 0 },
          "duplicate_executions": { "type": "integer", "minimum": 0 },
          "worker_instance_id": { "type": "string" }
        }
      }
    },
    "trace_ref": { "type": "string" }
  }
}
