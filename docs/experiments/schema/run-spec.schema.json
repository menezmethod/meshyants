{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshyants.dev/experiments/schema/run-spec.schema.json",
  "title": "MeshyAnts experiment run spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "phase",
    "hypothesis",
    "falsification",
    "workload",
    "worker_pool_ref",
    "single_agent_phenotype_id",
    "single_agent_selection_rule",
    "tools",
    "models",
    "budget",
    "systems",
    "repeats",
    "seeds",
    "rng_algorithm",
    "metrics",
    "comparison"
  ],
  "properties": {
    "contract_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["A", "B", "C", "D"] },
    "hypothesis": { "type": "string", "minLength": 1 },
    "falsification": { "type": "string", "minLength": 1 },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "tasks_ref", "decisive_swarm_benchmark"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "class": {
          "enum": [
            "homogeneous_dag",
            "heterogeneous_uncertain",
            "perturbation",
            "durable_dag"
          ]
        },
        "tasks_ref": { "type": "string", "minLength": 1 },
        "decisive_swarm_benchmark": { "type": "boolean" }
      }
    },
    "worker_pool_ref": { "type": "string", "minLength": 1 },
    "single_agent_phenotype_id": { "type": "string", "minLength": 1 },
    "single_agent_selection_rule": { "enum": ["highest_solo_success", "named"] },
    "single_agent_justification": { "type": "string" },
    "lease_contract_ref": { "type": "string" },
    "tools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "max_context_tokens": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "tokenizer": { "type": "string" },
    "price_book": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_micros_per_1k", "output_micros_per_1k"],
        "properties": {
          "input_micros_per_1k": { "type": "integer", "minimum": 0 },
          "output_micros_per_1k": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_wall_ms",
        "max_model_calls",
        "max_input_tokens",
        "max_output_tokens",
        "max_cost_micros",
        "max_worker_wakeups",
        "max_exclusive_lease_attempts",
        "max_allocation_messages"
      ],
      "properties": {
        "max_wall_ms": { "type": "integer", "minimum": 1 },
        "max_model_calls": { "type": "integer", "minimum": 0 },
        "max_input_tokens": { "type": "integer", "minimum": 0 },
        "max_output_tokens": { "type": "integer", "minimum": 0 },
        "max_cost_micros": { "type": "integer", "minimum": 0 },
        "max_worker_wakeups": { "type": "integer", "minimum": 1 },
        "max_exclusive_lease_attempts": { "type": "integer", "minimum": 0 },
        "max_allocation_messages": { "type": "integer", "minimum": 1 }
      }
    },
    "systems": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "single_agent",
          "manager_worker",
          "central_router",
          "meshyants",
          "flat_blackboard"
        ]
      }
    },
    "repeats": { "type": "integer", "minimum": 3 },
    "seeds": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "integer" }
    },
    "rng_algorithm": { "type": "string", "minLength": 1 },
    "failure_injection": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        }
      ]
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "task_success_rate",
          "quality",
          "wall_time_ms",
          "cost_micros",
          "model_calls",
          "input_tokens",
          "output_tokens",
          "duplicate_work_rate",
          "wakeup_count",
          "failed_claim_count",
          "allocation_message_count",
          "coordination_model_calls",
          "recovery_time_ms",
          "emergence_delta"
        ]
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["win_rule", "noise"],
      "properties": {
        "win_rule": { "enum": ["paired_sign_80"] },
        "noise": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_success_rate",
            "quality",
            "relative_cost_or_time"
          ],
          "properties": {
            "task_success_rate": { "type": "number", "minimum": 0 },
            "quality": { "type": "number", "minimum": 0 },
            "relative_cost_or_time": { "type": "number", "minimum": 0 },
            "duplicate_work_rate": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "allow_meshyants_coordination_llm": { "type": "boolean" }
  }
}
